  (pad "" np_thru_hole circle (at 2.89 -1.07) (size 0.65 0.65) (drill 0.65) (layers *.Cu *.Mask))
  (pad "" np_thru_hole circle (at -2.89 -1.07) (size 0.65 0.65) (drill 0.65) (layers *.Cu *.Mask))
