  (fp_line (start -5.32 5.68) (end 5.32 5.68) (layer "F.CrtYd") (width 0.05))
  (fp_line (start -5.32 -3.74) (end -5.32 5.68) (layer "F.CrtYd") (width 0.05))
  (fp_line (start -4.47 -2.12) (end -4.47 5.18) (layer "F.Fab") (width 0.1))
  (fp_line (start -4.47 -2.12) (end 4.47 -2.12) (layer "F.Fab") (width 0.1))
