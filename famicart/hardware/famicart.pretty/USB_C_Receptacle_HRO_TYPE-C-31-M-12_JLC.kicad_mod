  (pad "S1" thru_hole oval (at -4.32 -1.6) (size 1 2.1) (drill oval 0.6 1.7) (layers *.Cu *.Mask))
  (pad "S1" thru_hole oval (at 4.32 -1.6) (size 1 2.1) (drill oval 0.6 1.7) (layers *.Cu *.Mask))
  (pad "S1" thru_hole oval (at 4.32 2.58) (size 1 1.6) (drill oval 0.6 1.2) (layers *.Cu *.Mask))
  (model "${KICAD6_3DMODEL_DIR}/Connector_USB.3dshapes/USB_C_Receptacle_HRO_TYPE-C-31-M-12.wrl"
