(footprint "RPi_Pico_SMD" (version 20221018) (generator famicart)
  (layer "F.Cu")
  (descr "Raspberry Pi Pico / Pico 2 module, castellated SMD pads (40 + 3 debug) + USB test points TP1/TP2/TP3 per Pico 2 datasheet Fig.5. USB connector at -Y (top). Castellation pads sit on the datasheet pad line (first pad 1.37 mm from the module end). Pads 44-46 = TP1-TP3, TP4-TP7 and the USB shell pads A-D are no-net copper under the module, without paste: they keep tracks and vias away from the module's exposed test points (TP6 BOOTSEL, TP7 1V1) and USB shell legs. The module is hand-soldered at the castellations.")
  (tags "pico rp2040 rp2350 module")
