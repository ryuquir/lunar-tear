	(text "No pull-ups on the CPU data bus: they are known to upset some PPU revisions, and games read the floating bus."
		(exclude_from_sim no)
		(at 12 30 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "2679131f-fd36-5cb4-a928-d142dda55519")
	)
	(text "U1 is the donor's RP2A03 in a 40-pin socket.  In emulation mode the socket is empty and the dump shift registers drive the buses."
		(exclude_from_sim no)
		(at 12 20 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "2d4b2eba-e8c5-5423-b528-8462e1135c44")
	)
	(text "CPU: RP2A03, work RAM, address decoder, data-bus resistors"
		(exclude_from_sim no)
		(at 12 14 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left bottom)
		)
		(uuid "33745c5b-8c41-5e8c-b487-07838a24ef9b")
	)
	(text "The 470 ohm resistors let Pico B replace what the PPU sees on a write without disturbing the CPU side of the bus."
