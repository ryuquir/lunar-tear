	(text "No pull-ups on the CPU data bus: they are known to upset some PPU revisions, and games read the floating bus."
		(exclude_from_sim no)
		(at 12 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "72ee4305-bb6b-537b-9787-1ced88b43d42")
	)
	(text "The logic next to the CPU and the PPU is 74HCT: its inputs switch at TTL levels, which is what the two NMOS chips deliver."
		(exclude_from_sim no)
		(at 12 40 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "26c4421c-425e-5ba6-926a-fdc51605e89b")
	)
	(text "The 470 ohm resistors let Pico B replace what the PPU sees on a write.  A line that Pico B pulls low also drags the CPU side down,"
		(exclude_from_sim no)
		(at 12 25 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "98bdef91-a4b8-52f5-9865-7529041de58c")
	)
	(text "so the firmware reads the CPU side first and drives afterwards (README 3.9)."
		(exclude_from_sim no)
		(at 12 30 0)
