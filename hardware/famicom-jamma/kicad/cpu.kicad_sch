	(text "The 470 ohm resistors let Pico B replace what the PPU sees on a write without disturbing the CPU side of the bus."
		(exclude_from_sim no)
		(at 12 25 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7cc49998-c19b-4732-9286-b9bffa117688")
	)
	(text "No pull-ups on the CPU data bus: they are known to upset some PPU revisions, and games read the floating bus."
		(exclude_from_sim no)
		(at 12 30 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "d963a047-3298-46bb-9d5b-c17ff35decf6")
	)
	(text "CPU: RP2A03, work RAM, address decoder, data-bus resistors"
