	(text "The six 74HC595 run from +5V_SW; Pico C drives their inputs open-drain against 4.7 k pull-ups, so they see proper 5 V levels."
		(exclude_from_sim no)
		(at 12 30 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "0481e798-b33e-457c-8665-344ec46447b7")
	)
	(text "Dump circuit: with the CPU and PPU sockets empty, Pico C reads the cartridge through shift registers and hands the data to Pico A."
		(exclude_from_sim no)
		(at 12 25 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "35d90e45-7d1c-4130-ac62-aeff44f29fcf")
	)
	(text "Cartridge connector and the dump circuit for emulation mode"
		(exclude_from_sim no)
		(at 12 14 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left bottom)
		)
		(uuid "3fcf41b5-df18-4174-9b91-4681f4214bea")
	)
	(text "In real-chip mode D_OE_ADDR_N and D_OE_DATA_N stay high (pull-ups) and every 74HC595 output is switched off."
		(exclude_from_sim no)
		(at 12 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "518327ad-b99b-4751-a5c7-9b299fde2219")
	)
	(text "J8 is the 60-pin connector taken from the donor Famicom.  Pin 45 carries the board's sound to the cartridge, pin 46 brings it back."
		(exclude_from_sim no)
		(at 12 20 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "820a4648-c3a5-42e8-93f1-efa8de458e34")
	)
