			(justify left bottom)
		)
		(uuid "c2fe5c10-c4f3-52ec-b9a7-e0dad21f86ca")
	)
	(text "Pico B has forced bit 6 of register 2000 high.  The fifth bit (sprite or background) is read from the brightness of VOUT:"
		(exclude_from_sim no)
		(at 12 25 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "72eb9525-3bf7-5261-8b72-42ea1c2e4709")
	)
	(text "U6 is the donor's RP2C02, plugged into a 40-pin socket.  EXT0-3 give the lower four bits of the palette index of every pixel once"
