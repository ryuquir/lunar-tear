	(text "JAMMA edge connector, inputs, coin counter and lock-out drivers"
		(exclude_from_sim no)
		(at 12 14 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left bottom)
		)
		(uuid "451bc847-bd36-49ba-a8c6-9479f0205201")
	)
	(text "Pico C reads the chain: after a low pulse on IO_LATCH the first bit on IN_DATA is input H of U17, the last is input A of U20."
		(exclude_from_sim no)
		(at 12 25 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "4aa78a1b-dc22-4bcd-8811-ba72015d0aa5")
	)
	(text "The same pulse copies the 74HC595's shift register to its outputs, so one cycle reads the inputs and writes the outputs."
		(exclude_from_sim no)
		(at 12 30 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "71902504-1d78-4e32-bb02-bd9be927c5c7")
	)
	(text "Every input: 1 k pull-up to +3V3 (3.3 mA through the switch), 4.7 k in series, 10 nF to ground, then a 74HC165 on +3V3."
		(exclude_from_sim no)
		(at 12 20 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "a053c616-f624-4335-b398-b5e286dd8a85")
	)
	(text "Fingers 5/E (-5 V), 6/F (+12 V) and 11/M are not connected.  7/H is the key slot."
		(exclude_from_sim no)
		(at 12 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
