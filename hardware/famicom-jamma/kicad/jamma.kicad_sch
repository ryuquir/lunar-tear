	(text "Pico C reads the chain: after a low pulse on IO_LATCH the first bit on IN_DATA is input H of U17, the last is input A of U20."
		(exclude_from_sim no)
		(at 12 25 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "4879f5b4-77d8-5dd3-84af-00a36371c698")
	)
	(text "Every input: 1 k pull-up to +3V3 (3.3 mA through the switch), 4.7 k in series, 10 nF to ground, then a 74HC165 on +3V3."
		(exclude_from_sim no)
		(at 12 20 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "258f6a6a-3129-5833-9d01-a15a1c7c4e78")
	)
	(text "Fingers 5/E (-5 V), 6/F (+12 V) and 11/M are not connected.  7/H is the key slot."
		(exclude_from_sim no)
		(at 12 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "72de1f6b-d11f-59aa-b919-2434a5b5ff6c")
	)
	(text "The same pulse copies the 74HC595's shift register to its outputs, so one cycle reads the inputs and writes the outputs."
		(exclude_from_sim no)
		(at 12 30 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "56c23a59-489f-55d3-a472-3b360971caf1")
	)
