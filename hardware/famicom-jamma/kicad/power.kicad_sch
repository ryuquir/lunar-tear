	(text "Power: +5V entry, switched +5V_SW, +3V3, supply of the Pico modules"
		(exclude_from_sim no)
		(at 12 14 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left bottom)
		)
		(uuid "304172cf-fb0f-4bba-b1da-cafe0667e45c")
	)
	(text "+5V_IN comes from the JAMMA fingers 3, 4, C, D.  -5 V and +12 V are not used."
		(exclude_from_sim no)
		(at 12 20 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "39dd1b0a-3495-4e4b-8ed4-0edc4ea8390d")
	)
	(text "+5V_SW feeds the CPU, the PPU, the memories, the 5 V logic and the cartridge.  It is off until Pico C raises EN_5VSW,"
		(exclude_from_sim no)
		(at 12 25 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "3b94f273-c851-48a2-8992-758130757902")
	)
	(text "so that no 5 V signal reaches a Pico pin before that Pico is powered (the RP2350 pins tolerate 5 V only while powered)."
		(exclude_from_sim no)
		(at 12 30 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7161b201-6192-4e20-85bc-f5ce652322a3")
	)
	(text "VSYS feeds the three Pico modules and the +3V3 regulator from +5V or from the USB socket, whichever is present."
		(exclude_from_sim no)
		(at 12 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "e9c436be-62c8-41c6-a4f2-614354d6b9c5")
	)
