	(text "so that no 5 V signal reaches a Pico pin before that Pico is powered (the RP2350 pins tolerate 5 V only while powered)."
		(exclude_from_sim no)
		(at 12 30 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "8415da58-118b-55f9-9def-db0fe6ef89e5")
	)
	(text "Power: +5V entry, switched +5V_SW, +3V3, supply of the Pico modules"
		(exclude_from_sim no)
		(at 12 14 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left bottom)
		)
		(uuid "7be9cb90-d244-5f16-8e4e-f638061d7525")
	)
	(text "+5V_IN comes from the JAMMA fingers 3, 4, C, D.  -5 V is not used; +12 V only takes the turn-off current of the coils (sheet jamma)."
		(exclude_from_sim no)
		(at 12 20 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "943db4ea-dd75-5136-8de8-1fe12aeba971")
	)
	(text "VSYS feeds the three Pico modules and the +3V3 regulator from +5V or from the USB socket, whichever is present."
		(exclude_from_sim no)
		(at 12 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "a41fdeed-3fe5-5033-b847-081297ccd0af")
	)
	(text "+5V_SW feeds the CPU, the PPU, the memories, the 5 V logic and the cartridge.  It is off until Pico C raises EN_5VSW,"
		(exclude_from_sim no)
		(at 12 25 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "10b8b6f2-a1f2-5f8f-94d6-c728a9f31e80")
	)
