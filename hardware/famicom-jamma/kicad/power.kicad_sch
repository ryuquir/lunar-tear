	(text "+5V_SW feeds the CPU, the PPU, the memories, the 5 V logic and the cartridge through the power switch U29.  It is off until"
		(exclude_from_sim no)
		(at 12 25 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "55a02dc2-9df1-5666-9afd-ea71abf87aad")
	)
	(text "Power: +5V entry, switched +5V_SW, +3V3, supply of the Pico modules"
		(exclude_from_sim no)
		(at 12 14 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left bottom)
		)
		(uuid "d7168913-e9e1-590d-a91c-7ed08ed522d3")
	)
	(text "VSYS feeds the three Pico modules and the +3V3 regulator from +5V or from the USB socket, whichever is present."
		(exclude_from_sim no)
		(at 12 40 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c5574584-633f-504f-8381-b8049c5d1485")
	)
	(text "+5V_IN comes from the JAMMA fingers 3, 4, C, D.  -5 V and +12 V are not used.  Supply range at the fingers: 4.75 V to 5.25 V."
		(exclude_from_sim no)
		(at 12 20 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "210356d0-3d67-5b81-9a28-d93098471367")
	)
	(text "Pico C raises EN_5VSW, so that no 5 V signal reaches a Pico pin before that Pico is powered (the RP2350 pins tolerate 5 V only"
		(exclude_from_sim no)
		(at 12 30 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "eb482507-669e-5075-8536-f3502b50dc06")
	)
	(text "while powered).  U29 limits the current to about 1.3 A: a short circuit in a cartridge cannot draw the cabinet supply's full current."
		(exclude_from_sim no)
		(at 12 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "2e042bc7-77ea-5742-a136-1e7b307b59c7")
	)
