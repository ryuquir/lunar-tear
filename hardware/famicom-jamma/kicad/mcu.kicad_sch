		)
		(uuid "5eddb8dc-866f-40d9-b202-45dfa8d27f04")
	)
	(text "Pico A (video): clock and reset for CPU and PPU, palette index and sprite bit in, RGB and sync out; the emulator in emulation mode."
		(exclude_from_sim no)
		(at 12 20 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "8f0098f4-cda8-4eea-a211-fad3f34fb400")
	)
	(text "Pico B (bus): watches the CPU's accesses to the PPU, replaces palette data on the PPU side, answers the controller reads."
		(exclude_from_sim no)
		(at 12 25 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "b993da65-2ccb-474b-981e-376ff38630ae")
	)
	(text "power switch of the Famicom half, and reprogramming of Pico A and Pico B through their debug pins (J13, J14)."
		(exclude_from_sim no)
		(at 12 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "be9c7653-9c73-4a8d-83e2-dce1cc4ac5c6")
	)
