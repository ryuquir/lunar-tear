	(text "power switch of the Famicom half, and reprogramming of Pico A and Pico B through their debug pads."
		(exclude_from_sim no)
		(at 12 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "ff734111-2a7b-548a-85b7-58e001856a9b")
	)
	(text "Use either the board's Type-C socket or Pico C's own Micro-USB socket, never both at once: they are the same two wires."
		(exclude_from_sim no)
		(at 12 45 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "6a720f5c-a719-561a-8806-919932a2b589")
	)
	(text "Pico B (bus): watches the CPU's accesses to the PPU, replaces palette data on the PPU side, answers the controller reads."
		(exclude_from_sim no)
		(at 12 25 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "a7eb5ee0-0975-5d77-b5e7-a71e6b1d1df6")
	)
	(text "Pico A (video): clock and reset for CPU and PPU, palette index and sprite bit in, RGB and sync out; the emulator in emulation mode."
		(exclude_from_sim no)
		(at 12 20 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "a52374e0-33ee-593d-8018-96b1f6a9e5e2")
	)
	(text "The modules are soldered flat on the board.  The USB socket reaches Pico C through the pads under the module (TP2, TP3)."
		(exclude_from_sim no)
		(at 12 40 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "8c792e2d-21f6-55ab-91c1-9d81064bb3a9")
	)
	(text "Three Raspberry Pi Pico 2 modules, USB Type-C socket, links"
