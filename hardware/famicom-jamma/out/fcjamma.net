			(ref "JP2")
			(value "CLK 5V")
			(footprint "Jumper:SolderJumper-3_P1.3mm_Bridged12_RoundedPad1.0x1.5mm")
			(fields
				(field
					(name "Source") "PCB")
				(field
					(name "Note") "as made: Pico A's 3.3 V clock goes straight to the chips.  For a 5 V clock (in case a donor chip does not accept 3.3 V): CUT 1-2 FIRST, then bridge 2-3; the clock then passes through a gate of U5 (inverted, about 10 ns later).  Bridging 2-3 without cutting 1-2 sets the gate against Pico A's pin")
				(field
					(name "hierarchy_path") "/1de4cc9a-e2b8-52b0-afce-c09c3cf75d48/cefb83b8-9196-5570-bbf6-c9eabc5afd33")
