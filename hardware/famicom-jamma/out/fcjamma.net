		(comp
			(ref "R100")
			(value "47k")
			(footprint "Resistor_SMD:R_0603_1608Metric")
			(fields
				(field
					(name "Source") "JLC")
				(field
					(name "LCSC") "C25819")
				(field
					(name "Note") "while +5V_SW is off the /OE pins sit one diode above 0 V; this resistor keeps that from pulling DIP switch 1's line down through the transistor's body diode.  With the pins' own capacitance it also filters what an edge on the gate couples into the line; the outputs follow C_DUMP_EN within about 5 us")
				(field
					(name "hierarchy_path") "/1de4cc9a-e2b8-52b0-afce-c09c3cf75d48/90235916-7d90-5b2b-9054-fd20300f773e")
