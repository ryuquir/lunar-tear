		(comp
			(ref "Q3")
			(value "AO3400A")
			(footprint "Package_TO_SOT_SMD:SOT-23")
			(fields
				(field
					(name "Source") "JLC")
				(field
					(name "LCSC") "C20917")
				(field
					(name "Note") "holds the CPU in reset whenever Pico C enables the dump drivers: in reset the 2A03 releases all of its bus pins.  When C_DUMP_EN falls this clamp lets go a few microseconds before the drivers switch off, so Pico A must keep its own reset output low throughout emulation mode (README 3.9)")
				(field
					(name "hierarchy_path") "/1de4cc9a-e2b8-52b0-afce-c09c3cf75d48/90235916-7d90-5b2b-9054-fd20300f773e")
