			(footprint "Jumper:SolderJumper-3_P1.3mm_Bridged12_RoundedPad1.0x1.5mm")
			(fields
				(field
					(name "Source") "PCB")
				(field
					(name "Note") "as made: Pico A's 3.3 V clock goes straight to the chips.  For a 5 V clock (in case a donor chip does not accept 3.3 V): 1. cut 1-2, 2. bridge 2-3, 3. bridge JP3.  The clock then passes through a gate of U5 (inverted, about 10 ns later)")
